# PCA of Chr Z neo

A quick script to view clustering of autosomal diversity between species

Set up environment:
```
PROJDIR=/nas/bcch_for_danny/

SCRIPTDIR=${PROJDIR}/scripts/Chickadee_NeoSex
cd ${SCRIPTDIR}
git pull
REF=${PROJDIR}/data_from_will/ncbi_dataset/data/GCA_030490865.1/GCA_030490865.1_bPoeAtr1.hap1_genomic.fna

CHR=NeoZ
VCF=${PROJDIR}/data/vcfs/Z_noW.all_ind.diploid.vcf.gz 
OUTDIR=${PROJDIR}/analyses/pca/${CHR}
SAMPLEINFO=${PROJDIR}/reference_lists/sample_info.txt
SAMPLES=${PROJDIR}/reference_lists/males.allspecies.txt
${OUTDIR}/sex_calls.tsv
THREADS=8

micromamba activate bcf 

mkdir -p ${OUTDIR}
cd ${OUTDIR}
```
Create list of males from all taxa
```
awk -F'\t' 'NR > 1 && $6 == "M" {print $1}' \
    ${PROJDIR}/analyses/sex_inference/bcch/sex_calls.tsv \
    > ${PROJDIR}/reference_lists/bcch_males.txt

awk -F'\t' 'NR > 1 && $6 == "M" {print $1}' \
    ${PROJDIR}/analyses/sex_inference/moch/sex_calls.tsv \
    > ${PROJDIR}/reference_lists/moch_males.txt

awk -F'\t' 'NR > 1 && $6 == "M" {print $1}' \
    ${PROJDIR}/analyses/sex_inference/cach/sex_calls.tsv \
    > ${PROJDIR}/reference_lists/cach_males.txt

awk -F'\t' 'NR > 1 && $6 == "M" {print $1}' \
    ${PROJDIR}/analyses/sex_inference/boch/sex_calls.tsv \
    > ${PROJDIR}/reference_lists/boch_males.txt

cat ${PROJDIR}/reference_lists/bcch_males.txt ${PROJDIR}/reference_lists/moch_males.txt ${PROJDIR}/reference_lists/cach_males.txt ${PROJDIR}/reference_lists/boch_males.txt | sort | uniq > ${SAMPLES}
```
Check that samples are assigned species etc.
```
# report samples in the vcf that are missing from the species lists, and vice versa
bcftools query -l ${VCF} | sort > vcf_samples.txt
sort ${SAMPLES} > list_samples.sorted.txt
echo "In vcf but not in species lists (will be dropped):"
comm -23 vcf_samples.txt list_samples.sorted.txt
echo "In species lists but not in vcf:"
comm -13 vcf_samples.txt list_samples.sorted.txt
```
Analyze admixture using all samples from bcch, moch, cach, and boch
```
# keep listed samples, biallelic snps, recompute AC/AN, drop sites with maf < 0.05
bcftools view --threads ${THREADS} -r CM059970.1:25440000-62170000 -S ${SAMPLES} --force-samples ${VCF} -Ou | \
bcftools view --threads ${THREADS} -m2 -M2 -v snps -Ou | \
bcftools +fill-tags -Ou -- -t AF,AC,AN | \
bcftools view --threads ${THREADS} -q 0.05:minor -Oz -o ${CHR}.biallelic.maf05.vcf.gz

bcftools index ${CHR}.biallelic.maf05.vcf.gz

# convert to plink, assign unique snp ids, drop sites with > 20% missing data
plink --vcf ${CHR}.biallelic.maf05.vcf.gz \
--double-id --allow-extra-chr \
--set-missing-var-ids @:# \
--snps-only 'just-acgt' \
--geno 0.2 \
--make-bed --out ${CHR}

# prune linked snps: 50kb window, step of 1 snp, r2 threshold of 0.5
plink --bfile ${CHR} --allow-extra-chr \
--indep-pairwise 50kb 1 0.5 \
--out ${CHR}_filtered

plink --bfile ${CHR} --allow-extra-chr \
--extract ${CHR}_filtered.prune.in \
--make-bed --out ${CHR}_pruned

echo "Variants before pruning: $(wc -l < ${CHR}.bim)"
echo "Variants after pruning: $(wc -l < ${CHR}_pruned.bim)"

# pca
plink --bfile ${CHR}_pruned --allow-extra-chr \
--pca 10 \
--out ${CHR}_pruned

# plot, colored by species
Rscript ${SCRIPTDIR}/3a_Chr_PCA_plot.r ${OUTDIR}/${CHR}_pruned ${SAMPLEINFO} ${OUTDIR} ${CHR}

# make 3d plot
Rscript ${SCRIPTDIR}/3b_Chr_PCA_plot3d.r ${PROJDIR}/analyses/pca/NeoZ/NeoZ_pruned \
  ${PROJDIR}/reference_lists/sample_info.txt \
  ${PROJDIR}/analyses/pca/NeoZ NeoZ

# make admixture plot
KMIN=2
KMAX=6

# admixture only accepts integer chromosome codes, so copy the pruned files and recode the chromosome column
cp ${CHR}_pruned.bed ${CHR}_admix.bed
cp ${CHR}_pruned.fam ${CHR}_admix.fam
awk 'BEGIN{OFS="\t"} {$1=1; print}' ${CHR}_pruned.bim > ${CHR}_admix.bim

# run admixture for each K with 10-fold cross-validation
for K in $(seq ${KMIN} ${KMAX}); do
    admixture --cv=10 -j${THREADS} -s 12345 ${CHR}_admix.bed ${K} | tee ${CHR}_admix.K${K}.log
done

# collect cross-validation error, lowest is the best supported K
grep -h "CV error" ${CHR}_admix.K*.log | \
sed -E 's/CV error \(K=([0-9]+)\): ([0-9.]+)/\1\t\2/' | \
sort -n > ${CHR}_admix.cv_error.txt
echo "Cross-validation error by K:"
cat ${CHR}_admix.cv_error.txt

# plot, grouped by species
Rscript ${SCRIPTDIR}/3c_Chr2_admixture_plot.r ${OUTDIR} ${CHR}_admix ${SAMPLEINFO} ${KMIN} ${KMAX} ${CHR}
```

# Redo admix analysis with only moch, bcch, and cach (excluding boch)
```

SPECIES="BCCH MOCH CACH"
SUBSET=bcch_moch_cach
PREFIX=Chr2_${SUBSET}

# keep list (FID IID; FID = IID because B1_PCA.sh used --double-id)
awk -v sp="${SPECIES}" 'BEGIN{n=split(sp, a, " "); for (i=1; i<=n; i++) keep[a[i]]=1}
    NR > 1 && ($2 in keep) {print $1"\t"$1}' ${SAMPLEINFO} > ${SUBSET}.keep.txt

echo "Samples kept per species:"
awk -v sp="${SPECIES}" 'BEGIN{n=split(sp, a, " "); for (i=1; i<=n; i++) keep[a[i]]=1}
    NR > 1 && ($2 in keep) {print $2}' ${SAMPLEINFO} | sort | uniq -c

# subset samples, re-apply maf and missingness filters within the subset
plink --bfile Chr2 --allow-extra-chr \
--keep ${SUBSET}.keep.txt \
--maf 0.05 --geno 0.2 \
--make-bed --out ${PREFIX}

# prune linked snps within the subset: 50kb window, step of 1 snp, r2 threshold of 0.5
plink --bfile ${PREFIX} --allow-extra-chr \
--indep-pairwise 50kb 1 0.5 \
--out ${PREFIX}_filtered

plink --bfile ${PREFIX} --allow-extra-chr \
--extract ${PREFIX}_filtered.prune.in \
--make-bed --out ${PREFIX}_pruned

echo "Samples: $(wc -l < ${PREFIX}_pruned.fam)"
echo "Variants before pruning: $(wc -l < ${PREFIX}.bim)"
echo "Variants after pruning: $(wc -l < ${PREFIX}_pruned.bim)"

# admixture only accepts integer chromosome codes, so recode the chromosome column in a copy
cp ${PREFIX}_pruned.bed ${PREFIX}_admix.bed
cp ${PREFIX}_pruned.fam ${PREFIX}_admix.fam
awk 'BEGIN{OFS="\t"} {$1=1; print}' ${PREFIX}_pruned.bim > ${PREFIX}_admix.bim

# run admixture for each K with 10-fold cross-validation
for K in $(seq ${KMIN} ${KMAX}); do
    admixture --cv=10 -j${THREADS} -s 12345 ${PREFIX}_admix.bed ${K} | tee ${PREFIX}_admix.K${K}.log
done

# collect cross-validation error, lowest is the best supported K
grep -h "CV error" ${PREFIX}_admix.K*.log | \
sed -E 's/CV error \(K=([0-9]+)\): ([0-9.]+)/\1\t\2/' | \
sort -n > ${PREFIX}_admix.cv_error.txt
echo "Cross-validation error by K:"
cat ${PREFIX}_admix.cv_error.txt

# plot, grouped by species
Rscript ${SCRIPTDIR}/3c_Chr2_admixture_plot.r ${OUTDIR} ${PREFIX}_admix ${SAMPLEINFO} ${KMIN} ${KMAX} ${PREFIX}

```
